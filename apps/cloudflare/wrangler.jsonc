// Cloudflare deployment (free plan): Workers Assets serve the client, one Durable Object runs the
// office room. Build + deploy with `bun run deploy` from this folder (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "office-fps",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  // dist/ is already bundled by build.ts; wrangler only picks up the .wasm next to it (its
  // default rule uploads *.wasm as a compiled module).
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist",
  "assets": { "directory": "../client/dist" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "SETTINGS", "class_name": "Settings" },
      { "name": "SAVES", "class_name": "SaveVault" }
    ]
  },
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Settings"] },
    { "tag": "v3", "new_sqlite_classes": ["SaveVault"] }
  ],
  // Requests a day before new joins are told the servers are resting (at 95%). The free plan
  // allows 100000; set "0" after moving to the paid plan to turn the cutoff off.
  "vars": { "FREE_REQUEST_LIMIT": "100000" },
  "observability": { "enabled": true }
}
