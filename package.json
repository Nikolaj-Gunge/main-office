{
  "name": "office-fps",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter @office-fps/client build",
    "start": "bun run --filter @office-fps/server start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bots": "bun apps/server/src/tools/bots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
